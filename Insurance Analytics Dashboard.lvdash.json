{
  "datasets": [
    {
      "name": "496890c0",
      "displayName": "Customer Count Summary from Insurance Dataset",
      "queryLines": [
        "SELECT COUNT(*) AS total_customers\r\n",
        "FROM insurance.gold.dim_customer; "
      ]
    },
    {
      "name": "75bce153",
      "displayName": "Total Policies",
      "queryLines": [
        "SELECT COUNT(*) AS total_policies\r\n",
        "FROM insurance.gold.fact_policy;"
      ]
    },
    {
      "name": "992bb60b",
      "displayName": "Total Premium",
      "queryLines": [
        "SELECT SUM(premium_amount) AS total_premium\r\n",
        "FROM insurance.gold.fact_policy;"
      ]
    },
    {
      "name": "50f482b2",
      "displayName": "Total Claims",
      "queryLines": [
        "SELECT COUNT(*) AS total_claims\r\n",
        "FROM insurance.gold.fact_claim;"
      ]
    },
    {
      "name": "4e0c9a71",
      "displayName": "Claim Amount by Status",
      "queryLines": [
        "SELECT\r\n",
        "    claim_status,\r\n",
        "    SUM(claim_amount) AS total_claim_amount\r\n",
        "FROM insurance.gold.fact_claim\r\n",
        "GROUP BY claim_status\r\n",
        "ORDER BY total_claim_amount DESC;"
      ]
    },
    {
      "name": "a1760845",
      "displayName": "Payment Amount by Payment Method",
      "queryLines": [
        "SELECT\r\n",
        "    payment_method,\r\n",
        "    SUM(amount) AS total_payment\r\n",
        "FROM insurance.gold.fact_payment\r\n",
        "GROUP BY payment_method\r\n",
        "ORDER BY total_payment DESC;"
      ]
    },
    {
      "name": "29673ac8",
      "displayName": "Premium by Product",
      "queryLines": [
        "SELECT\r\n",
        "    dp.product_name,\r\n",
        "    SUM(fp.premium_amount) AS total_premium\r\n",
        "FROM insurance.gold.fact_policy fp\r\n",
        "JOIN insurance.gold.dim_product dp\r\n",
        "    ON fp.product_key = dp.product_key\r\n",
        "GROUP BY dp.product_name\r\n",
        "ORDER BY total_premium DESC;"
      ]
    },
    {
      "name": "e134d2dd",
      "displayName": "Coverage by Product",
      "queryLines": [
        "SELECT\r\n",
        "    dp.product_name,\r\n",
        "    SUM(fp.coverage_amount) AS total_coverage\r\n",
        "FROM insurance.gold.fact_policy fp\r\n",
        "JOIN insurance.gold.dim_product dp\r\n",
        "    ON fp.product_key = dp.product_key\r\n",
        "GROUP BY dp.product_name\r\n",
        "ORDER BY total_coverage DESC;"
      ]
    },
    {
      "name": "f99f4823",
      "displayName": "Policy Status",
      "queryLines": [
        "SELECT\r\n",
        "    policy_status,\r\n",
        "    COUNT(*) AS policy_count\r\n",
        "FROM insurance.gold.fact_policy\r\n",
        "GROUP BY policy_status\r\n",
        "ORDER BY policy_count DESC;"
      ]
    },
    {
      "name": "df16d332",
      "displayName": "Untitled dataset",
      "queryLines": [
        ""
      ]
    },
    {
      "name": "7419b1e8",
      "displayName": "Untitled dataset 1",
      "queryLines": [
        ""
      ]
    },
    {
      "name": "6ae1c3f0",
      "displayName": "Customer Location Details",
      "queryLines": [
        "SELECT\r\n",
        "    customer_key,\r\n",
        "    first_name,\r\n",
        "    last_name,\r\n",
        "    city,\r\n",
        "    state\r\n",
        "FROM insurance.gold.dim_customer\r\n",
        "ORDER BY customer_key;"
      ]
    }
  ],
