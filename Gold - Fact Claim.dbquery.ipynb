   "source": [
    "CREATE OR REPLACE TABLE insurance.gold.fact_claim AS\n",
    "SELECT\n",
    "    c.id AS claim_key,\n",
    "    c.policy_id AS policy_key,\n",
    "    c.claim_date AS claim_date_key,\n",
    "    c.claim_number,\n",
    "    c.claim_amount,\n",
    "    c.approved_amount,\n",
    "    c.claim_status,\n",
    "    c.created_at\n",
    "FROM insurance.silver.claims c;"
   ]
  }
