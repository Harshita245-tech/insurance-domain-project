   "source": [
    "MERGE INTO insurance.bronze.customers AS target\n",
    "USING insurance_source.public.customers AS source\n",
    "ON target.id = source.id\n",
    "\n",
    "WHEN MATCHED AND (\n",
    "    target.updated_at IS NULL\n",
    "    OR source.updated_at > target.updated_at\n",
    ")\n",
    "THEN UPDATE SET *\n",
    "\n",
    "WHEN NOT MATCHED\n",
    "THEN INSERT *;"
   ]
  }
 ],
